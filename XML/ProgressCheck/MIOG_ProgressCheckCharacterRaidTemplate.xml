<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_ProgressCheckCharacterRaidTemplate" virtual="true">
        <Frames>
            <Frame parentKey="Header" inherits="MIOG_ProgressCheckCharacterOverviewHeaderTemplate">
                <Size y="150" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT"/>
                    <Anchor point="TOPRIGHT" relativeKey="$parent" relativePoint="TOPRIGHT" />
                </Anchors>
            </Frame>
            
            <Frame parentKey="CellList" inherits="MIOG_ProgressCheckCellListTemplate" >
                <KeyValues>
                    <KeyValue key="template" value="MIOG_ProgressCheckCharacterRaidCellTemplate" type="string" />
                </KeyValues>

                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
            </Frame>
        </Frames>
        
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="DividerLeft" atlas="delves-dashboard-bar-divider-complete">
                    <Size x="2" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="6" y="1"/>
                        <Anchor point="BOTTOMLEFT" x="6" y="-1"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="DividerRight" atlas="delves-dashboard-bar-divider-complete">
                    <Size x="2" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-7" y="1"/>
                        <Anchor point="BOTTOMRIGHT" x="-7" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
</Ui>

