<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_ProgressCheckCharacterCellTemplate" virtual="true">
        <Size y="25" />
        
        <KeyValues>
            <KeyValue key="expand" value="true" type="boolean" />
			<KeyValue key="align" value="center" type="string"/>
        </KeyValues>

        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL">
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLeave function="GameTooltip_Hide" />
        </Scripts>
    </Frame>
</Ui>