<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_ProgressCheck" mixin="ProgressCheckMixin" virtual="true">
        <Frames>
            <EventFrame parentKey="ScrollBar" inherits="MIOG_MinimalHorizontalScrollBarTemplate">
                <Size y="16" />

                <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </EventFrame>

            <Frame parentKey="InfoColumn" inherits="MIOG_ProgressCheckCharacterOverviewInfoColumnTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBar" relativePoint="TOPLEFT"/>
                </Anchors>
            </Frame>

            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.InfoColumn" relativePoint="TOPRIGHT"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBar" relativePoint="TOPRIGHT"/>
                </Anchors>
            </Frame>
        </Frames>

        <Layers>
			<Layer level="BORDER">
				<Texture parentKey="Background1" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background2" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background3" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background4" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background5" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background6" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background7" horizTile="true" vertTile="true"/>
				<Texture parentKey="Background8" horizTile="true" vertTile="true"/>
			</Layer>
        </Layers>

        <Scripts>
            <OnEvent method="OnEvent" />  
            <OnLoad method="OnLoad" />  
            <OnShow method="OnShow" />
        </Scripts>
    </Frame>

    <Frame name="MIOG_ProgressCheckHeaderTemplate" mixin="ProgressCheckHeaderMixin" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="MIOG_ProgressCheckCellTemplate" mixin="ProgressCheckCellMixin" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>
</Ui>