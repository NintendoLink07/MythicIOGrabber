<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_FilterSettings" mixin="FilterSettings" virtual="true">
        <Frames>
            <Frame parentKey="FilterList" inherits="VerticalLayoutFrame" setAllPoints="true">
                <KeyValues>
                    <KeyValue key="spacing" value="4" type="number"/>
                    <KeyValue key="expand" value="true" type="boolean"/>
                </KeyValues>

                <Frames>
                    <Frame parentKey="SortDrop" inherits="VerticalLayoutFrame">
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="1" type="number" />
                            <KeyValue key="minimumHeight" value="40" type="number" />
                            <KeyValue key="expand" value="true" type="boolean"/>
                        </KeyValues>

                        <Layers>
                            <Layer level="OVERLAY">
                                <FontString parentKey="Instructions" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL" text="Drop a sort filter here...">
                                    <Color r="0.6" g="0.6" b="0.6" a="1" />
                                    <Anchors>
                                        <Anchor point="CENTER"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>

                    <Frame parentKey="SortFilterBucket" inherits="VerticalLayoutFrame">
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="2" type="number" />
                            <KeyValue key="minimumHeight" value="40" type="number" />
                            <KeyValue key="expand" value="true" type="boolean"/>
                        </KeyValues>

                        <Layers>
                            <Layer level="OVERLAY">
                                <FontString parentKey="Instructions" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL" text="Bucket..." hidden="true">
                                    <Color r="0.6" g="0.6" b="0.6" a="1" />
                                    <Anchors>
                                        <Anchor point="CENTER"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>

                    <Frame parentKey="Activities" inherits="ResizeLayoutFrame">
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="3" type="number" />
                            <KeyValue key="expand" value="true" type="boolean"/>
                        </KeyValues>

                        <Frames>
                            <Frame parentKey="ButtonFrame" inherits="MIOG_ModernCheckButtonFrameTemplate">
                                <Size x="100" y="20" />
                                <Anchors>
                                    <Anchor point="TOPLEFT"/>
                                </Anchors>
                            </Frame>
                                
                            <Frame parentKey="Grid" inherits="StaticGridLayoutFrame">
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeKey="$parent.ButtonFrame" relativePoint="BOTTOMLEFT" y="-2"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Anchors>
                            </Frame>
                        </Frames>
                    </Frame>
                    
                    <Frame parentKey="Difficulty" inherits="ResizeLayoutFrame">
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="4" type="number" />
                            <KeyValue key="expand" value="true" type="boolean"/>
                        </KeyValues>

                        <Frames>
                            <CheckButton parentKey="CheckButton" inherits="MIOG_MinimalCheckButtonTemplate">
                                <Size x="22" y="22" />
                                <Anchors>
                                    <Anchor point="LEFT"/>
                                </Anchors>
                            </CheckButton>

                            <DropdownButton parentKey="Dropdown" inherits="MIOG_FilterSettingsDropdownTemplate">
                                <Anchors>
                                    <Anchor point="LEFT" relativeKey="$parent.CheckButton" relativePoint="RIGHT" x="2"/>
                                </Anchors>
                            </DropdownButton>
                        </Frames>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
     
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnEvent method="OnEvent" />
        </Scripts>
    </Frame>
</Ui>