<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrameSmallGroupResultFrameTemplate"  inherits="MIOG_SearchFrameStandardResultFrameTemplate" mixin="SearchFrameResultFrameMixin" virtual="true">
        <Frames>
            <Frame parentKey="General" inherits="MIOG_SearchFrameStandardResultFrameGeneralRowTemplate">
                <Size y="20" />
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
            </Frame>
            
            <Frame parentKey="Activity">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.General" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Frames>
                    <CheckButton parentKey="Expand" inherits="MIOG_SearchFrameExpandButtonTemplate">
                        <Size x="18" y="18" />
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                    </CheckButton>
                </Frames>

                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Name" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" wordwrap="false" nonspacewrap="false">
                            <Size x="128" />
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.Expand" relativePoint="RIGHT" x="4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <Frame parentKey="Members" inherits="HorizontalLayoutFrame">
                        <KeyValues>
                            <KeyValue key="spacing" value="16" type="number"/>
                        </KeyValues>

                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="RIGHT" x="24"/>
                            <Anchor point="RIGHT" x="-30"/>
                        </Anchors>

                        <Frames>
                            <Frame parentArray="memberFrames" inherits="MIOG_SearchFrameGroupMemberTemplate">
                                <Size x="16" y="16" />

                                <KeyValues>
                                    <KeyValue key="layoutIndex" value="1" type="number"/>
                                </KeyValues>
                            </Frame>

                            <Frame parentArray="memberFrames" inherits="MIOG_SearchFrameGroupMemberTemplate">
                                <Size x="16" y="16" />

                                <KeyValues>
                                    <KeyValue key="layoutIndex" value="2" type="number"/>
                                </KeyValues>
                            </Frame>

                            <Frame parentArray="memberFrames" inherits="MIOG_SearchFrameGroupMemberTemplate">
                                <Size x="16" y="16" />

                                <KeyValues>
                                    <KeyValue key="layoutIndex" value="3" type="number"/>
                                </KeyValues>
                            </Frame>

                            <Frame parentArray="memberFrames" inherits="MIOG_SearchFrameGroupMemberTemplate">
                                <Size x="16" y="16" />

                                <KeyValues>
                                    <KeyValue key="layoutIndex" value="4" type="number"/>
                                </KeyValues>
                            </Frame>

                            <Frame parentArray="memberFrames" inherits="MIOG_SearchFrameGroupMemberTemplate">
                                <Size x="16" y="16" />

                                <KeyValues>
                                    <KeyValue key="layoutIndex" value="5" type="number"/>
                                </KeyValues>
                            </Frame>
                        </Frames>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>