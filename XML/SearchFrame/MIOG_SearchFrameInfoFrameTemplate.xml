                    <Frame parentKey="Dungeon8" parentArray="childFrames" inherits="MIOG_SearchFrameInfoFrameDungeonTemplate">
                        <Size y="16" />

                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Dungeon7" relativePoint="BOTTOMLEFT" y="-2"/>
                            <Anchor point="TOPRIGHT" relativeKey="$parent.Dungeon7" relativePoint="BOTTOMRIGHT" y="-2"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
            
            <Frame parentKey="Raids">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-2"/>
                    <Anchor point="BOTTOMRIGHT" x="-2"/>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Dungeons" relativePoint="TOPRIGHT"/>
                </Anchors>
                
                <Frames>
                    <Frame parentKey="Raid1" inherits="MIOG_SearchFrameInfoFrameRaidTemplate" hidden="true">
                        <Size y="32" />

                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>
                    </Frame>

                    <Frame parentKey="Raid2" inherits="MIOG_SearchFrameInfoFrameRaidTemplate" hidden="true">
                        <Size y="34" />

                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Raid1" relativePoint="BOTTOMLEFT" y="-2"/>
                            <Anchor point="TOPRIGHT" relativeKey="$parent.Raid1" relativePoint="BOTTOMRIGHT" y="-2"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>

        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1"> 
                <Texture parentKey="Background" setAllPoints="true" vertTile="true" horizTile="true"/>
            </Layer>

            <Layer level="BACKGROUND"> 
                <Texture parentKey="TransparentDark" setAllPoints="true">
                    <Color r="0.1" g="0.1" b="0.1" a="0.5" />
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString parentKey="Comment" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL">
                    <Size y="16" />
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Dungeons" relativePoint="BOTTOMRIGHT" x="2"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="Realm" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL">
                    <Size y="16" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Comment" relativePoint="TOPLEFT" y="2"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Comment" relativePoint="TOPRIGHT" y="2"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="KeysDone" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL">
                    <Size y="16" />
