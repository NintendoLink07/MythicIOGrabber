<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrameInfoFrameDungeonTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentkey="Icon">
                    <Size x="16" y="16" />
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </Texture>

                <FontString parentKey="Name" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" text="DUNGEON NAME">
                    <Size x="60" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="4"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="Text" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL" text="DUNGEON NAME">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="RIGHT" x="4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>