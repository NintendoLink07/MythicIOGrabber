<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrameStandardResultFrameGeneralRowWithRatingTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY"> 
                <Texture parentKey="Icon">
                    <Size x="18" y="18" />
                    <Anchors>
                        <Anchor point="LEFT" />
                    </Anchors>
                </Texture>

                <FontString parentKey="Title" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" wordwrap="false" nonspacewrap="false">
                    <Size x="128" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="4"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="Composition" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" text="[0||0||0]">
                    <Size x="60" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Title" relativePoint="RIGHT" x="24"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="Rating" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL" text="0000">
                    <Size x="50" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Composition" relativePoint="RIGHT"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="SecondaryRating" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL" text="0000">
                    <Size x="50" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Rating" relativePoint="RIGHT"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>