<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrameBattlegroundResultFrameTemplate" inherits="MIOG_SearchFrameStandardResultFrameTemplate" mixin="SearchFramePVPResultFrameMixin" virtual="true">
        <Size y="40" />

        <Frames>
            <Frame parentKey="General" inherits="MIOG_SearchFrameStandardResultFrameGeneralRowWithRatingTemplate">
                <Size y="20" />
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
            </Frame>

            <Frame parentKey="Activity">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.General" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Frames>
                    <CheckButton parentKey="Expand" inherits="MIOG_SearchFrameExpandButtonTemplate">
                        <Size x="18" y="18" />
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                    </CheckButton>
                </Frames>

                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Name" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL" wordwrap="false" nonspacewrap="false">
                            <Size x="128" />
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.Expand" relativePoint="RIGHT" x="4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <Frame parentKey="Members" inherits="MIOG_SearchFrameBigGroupRowTemplate">
                        <Size y="16" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-2" y="-2"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>