<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrame" inherits="BackdropTemplate" mixin="SearchFrameMixin" virtual="true">
        <Frames>
            <Frame parentKey="Header">
                <Size y="42" />

                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>

                <Frames>
                    <Button parentKey="SearchButton" inherits="UIPanelDynamicResizeButtonTemplate" text="Search">
                        <Size y="22" />
                        <Anchors>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>

                        <Scripts>
                            <OnLoad>
                                self:FitToText()
                            </OnLoad>
                            <OnClick>
                                PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
		                        LFGListSearchPanel_DoSearch(LFGListFrame.SearchPanel)
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button parentKey="ActivitySort" inherits="MIOG_SearchFrameSortButtonTemplate">
                        <Size y="22" />
                        <Anchors>
                            <Anchor point="BOTTOMLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():TriggerSort(self, "activityName")
                            </OnClick>
                            <OnLoad>
                                self.Text:SetText("Activity")
                            </OnLoad>
                        </Scripts>
                    </Button>

                    <!--<Button parentKey="SecondaryRatingSort" inherits="MIOG_SearchFrameSortButtonTemplate">
                        <Size x="88" y="22" />
                        <Anchors>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():TriggerSort(self, "secondaryRating")
                            </OnClick>
                            <OnLoad>
                                self.Text:SetText("2. Rating")
                            </OnLoad>
                        </Scripts>
                    </Button>!-->

                    <Button parentKey="RatingSort" inherits="MIOG_SearchFrameSortButtonTemplate">
                        <Size x="87" y="22" />
                        <Anchors>
                            <Anchor point="BOTTOMRIGHT"/>
                            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOM"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():TriggerSort(self, "rating")
                            </OnClick>
                            <OnLoad>
                                self.Text:SetText("Rating")
                            </OnLoad>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
            
            <Frame parentKey="Footer" inherits="BackdropTemplate">
                <Size y="24" />

                <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Frames>
                    <Button parentKey="Back" inherits="UIPanelButtonTemplate" text="BACK">
                        <Size x="60" y="22" />

                        <Anchors>
                            <Anchor point="LEFT" x="2"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
                                LFGListFrame_SetActivePanel(LFGListFrame, LFGListFrame.CategorySelection);
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button parentKey="SignUp" inherits="UIPanelButtonTemplate" text="SIGN_UP">
                        <Size x="80" y="22" />

                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.Back" relativePoint="RIGHT" x="2"/>
                        </Anchors>

                        <Scripts>
                            <OnLoad>
                                self:SetEnabled(false)
                            </OnLoad>
                            <OnClick>
                                PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
                                if(LFGListFrame.SearchPanel.selectedResult and C_LFGList.HasSearchResultInfo(LFGListFrame.SearchPanel.selectedResult)) then
                                    LFGListApplicationDialog_Show(LFGListApplicationDialog, LFGListFrame.SearchPanel.selectedResult)

                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <CheckButton parentKey="RaidCompButton" inherits="MIOG_ModernCheckButtonFrameTemplate">
                        <Size y="20" />
                        <Anchors>
                            <Anchor point="RIGHT" x="-2"/>
                        </Anchors>
                    </CheckButton>
                </Frames>
            </Frame>
            
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="2"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Footer" relativePoint="TOPRIGHT" x="-2"/>
                </Anchors>
            </Frame>
        </Frames>

        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Status" font="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" outline="NORMAL">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" x="2" y="-4"/>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.ScrollBox" x="2" y="-4"/>
                    </Anchors>
                </FontString>
            </Layer>
        
            <Layer level="BACKGROUND" textureSubLevel="-3">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.95" />
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnEvent method="OnEvent" />
            <OnEnter>

            </OnEnter>
        </Scripts>
    </Frame>
</Ui>

