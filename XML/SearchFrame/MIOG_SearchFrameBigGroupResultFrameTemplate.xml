<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MIOG_SearchFrameBigGroupResultFrameTemplate" inherits="MIOG_SearchFrameStandardResultFrameTemplate" mixin="SearchFrameBigGroupResultFrameMixin" virtual="true">
        <Frames>
            <Frame parentKey="General" inherits="MIOG_SearchFrameStandardResultFrameGeneralRowTemplate">
                <Size y="20" />
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
            </Frame>
            
            <Frame parentKey="Activity">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.General" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Frames>
                    <CheckButton parentKey="Expand" inherits="MIOG_SearchFrameExpandButtonTemplate">
                        <Size x="18" y="18" />
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                    </CheckButton>
                </Frames>

                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Name" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL">
                            <Size x="128" />
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.Expand" relativePoint="RIGHT" x="4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <Frame parentKey="Members" hidden="true" />

                    <Frame parentKey="MemberRow1" inherits="MIOG_SearchFrameBigGroupRowTemplate">
                        <Size y="16" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-4"/>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="TOPRIGHT"/>
                        </Anchors>
                    </Frame>

                    <Frame parentKey="MemberRow2" inherits="MIOG_SearchFrameBigGroupRowTemplate">
                        <Size y="16" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.MemberRow1" relativePoint="BOTTOMLEFT" y="-2"/>
                            <Anchor point="TOPRIGHT" relativeKey="$parent.MemberRow1" relativePoint="BOTTOMRIGHT" y="-2"/>
                        </Anchors>
                    </Frame>

                    <Frame parentKey="MemberRow3" inherits="MIOG_SearchFrameBigGroupRowTemplate">
                        <Size y="16" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.MemberRow2" relativePoint="BOTTOMLEFT" y="-2"/>
                            <Anchor point="TOPRIGHT" relativeKey="$parent.MemberRow2" relativePoint="BOTTOMRIGHT" y="-2"/>
                        </Anchors>
                    </Frame>

                    <Frame parentKey="MemberRow4" inherits="MIOG_SearchFrameBigGroupRowTemplate">
                        <Size y="16" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.MemberRow3" relativePoint="BOTTOMLEFT" y="-2"/>
                            <Anchor point="TOPRIGHT" relativeKey="$parent.MemberRow3" relativePoint="BOTTOMRIGHT" y="-2"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>