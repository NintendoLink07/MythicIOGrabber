<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MIOG_SearchFrameSortButtonTemplate" inherits="BackdropTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" outline="NORMAL">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>

            <Layer level="ARTWORK">
                <Texture parentKey="SortArrow" atlas="auctionhouse-ui-sortarrow" hidden="true">
                    <Size x="12" y="12" />
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Text" relativePoint="RIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <HighlightTexture atlas="CampaignHeader_SelectedGlow">
            <Anchors>
                <Anchor point="TOPLEFT" y="-2"/>
                <Anchor point="BOTTOMRIGHT"/>
            </Anchors>
        </HighlightTexture>
    </Button>
</Ui>